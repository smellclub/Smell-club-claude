# =====================================================================
# Smellclub · Variables de entorno (PLANTILLA — sin secretos)
# Copia este archivo como .env.local y rellena los valores.
# En Vercel: Project → Settings → Environment Variables.
# =====================================================================

# URL pública de la web (sin barra final). Ej: https://smellclub.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings → API Keys / Data API) ----------------
# URL del proyecto. Ej: https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Clave PÚBLICA ("Publishable key", empieza por sb_publishable_…,
# o la antigua "anon public"). Es segura en el navegador gracias a RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 🔒 SECRETA ("Secret key", empieza por sb_secret_…, o la antigua
# "service_role"). SOLO servidor. NUNCA con prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# 🔒 Texto aleatorio largo (mín. 32 caracteres) para anonimizar IPs
# en el rate limiting. Genera uno en https://1password.com/password-generator
RATE_LIMIT_SALT=

# --- Tienda ------------------------------------------------------------
# Moneda ISO 4217 (EUR, USD, MXN, COP, CLP, ARS…) y formato regional
NEXT_PUBLIC_CURRENCY=EUR
NEXT_PUBLIC_LOCALE=es-ES

# --- Contacto / redes (déjalos vacíos hasta tenerlos) -------------------
# WhatsApp en formato internacional SOLO dígitos, sin + ni espacios. Ej: 34600111222
NEXT_PUBLIC_WHATSAPP_NUMBER=
# URL completa del perfil. Ej: https://www.instagram.com/smellclub
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
